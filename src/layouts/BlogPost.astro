---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  minutesRead?: string;
}

const { title, description, pubDate, updatedDate, tags = [], minutesRead } =
  Astro.props;
---

<BaseLayout title={title} description={description} type="article">
  <article class="container">
    <header class="post-header prose rise">
      <a href="/blog" class="back-link">← All posts</a>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {minutesRead && <span class="dot">·</span>}
        {minutesRead && <span>{minutesRead}</span>}
        {
          updatedDate && (
            <span class="updated">
              (updated <FormattedDate date={updatedDate} />)
            </span>
          )
        }
      </div>
      <h1>{title}</h1>
      <p class="lede muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="post-body prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  async function renderMermaidDiagrams() {
    // Find all Shiki/Astro rendered pre blocks containing mermaid language
    const mermaidPres = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.astro-code[data-language="mermaid"], pre:has(code.language-mermaid)'
    );

    mermaidPres.forEach((pre, index) => {
      const code = pre.querySelector('code') || pre;
      const graphDefinition = code.textContent || '';
      
      const container = document.createElement('div');
      container.className = 'mermaid-container';
      
      const graphDiv = document.createElement('pre');
      graphDiv.className = 'mermaid';
      graphDiv.textContent = graphDefinition.trim();
      
      container.appendChild(graphDiv);
      pre.parentNode?.replaceChild(container, pre);
    });

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'loose',
      fontFamily: 'var(--font-sans)',
    });

    await mermaid.run();
  }

  // Initial render
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
  } else {
    renderMermaidDiagrams();
  }

  // Listen for theme toggle to re-render if needed
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        mermaid.initialize({
          theme: isDark ? 'dark' : 'default',
        });
      }
    }
  });
  observer.observe(document.documentElement, { attributes: true });
</script>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .dot {
    opacity: 0.5;
  }
  .post-header h1 {
    font-size: clamp(2rem, 5vw, 2.9rem);
    margin-bottom: 0.9rem;
  }
  .lede {
    font-size: 1.2rem;
    line-height: 1.5;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0;
  }
  .tags li {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }

  .post-body {
    margin-top: 2.5rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  /* Article typography */
  .post-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.65rem;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }
  .post-body :global(h3) {
    font-family: var(--font-sans);
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .post-body :global(p) {
    margin-bottom: 1.35rem;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.35rem 1.25rem;
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(img) {
    border-radius: var(--radius-sm);
    margin: 2rem 0;
  }
  .post-body :global(pre) {
    font-family: var(--font-mono);
    margin: 1.75rem 0;
  }

  /* Mermaid diagram styling */
  .post-body :global(.mermaid-container) {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .post-body :global(.mermaid) {
    font-family: var(--font-sans) !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .post-body :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
</style>
